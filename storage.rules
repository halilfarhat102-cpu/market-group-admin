rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Merchant uploads
    match /merchants/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Product uploads
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default deny for other paths
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
